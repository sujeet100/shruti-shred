# IDE
.idea/
.vscode/

# Python
__pycache__/
*.py[cod]
.venv/

# Secrets — never commit real keys (commit .env.example instead)
.env

# Run history IS committed: each run's composition JSON, MIDI, chart, listening report and
# experiment notes (out/), every agent trace (traces/), and the talk clips' source data
# (talk/audio/build/). The catalogues that explain them: out/README.md, traces/README.md,
# talk/audio/README.md. Media stay out — a WAV re-renders from its JSON/MIDI for free.
*.wav
*.mp4
out/**/*.png
out/**/*.jpg
talk/audio/*.png
talk/audio/build/keyboard*/*.png
out/**/frames/

# Soundfont — 38MB binary asset, downloaded separately (see soundfonts/README.md)
soundfonts/*.sf3
soundfonts/*.sf2

# Talk deck build output + previews — regenerated by talk/deck/build.py and preview.py
talk/deck/project/
talk/deck/preview/
talk/deck/font-compare/
talk/deck/sheet*.png
talk/deck/shots/*.png

# Local Claude Code worktrees
.claude/worktrees/

# macOS
.DS_Store

# Written by the fake render path in tests/test_flow.py — not a run
out/fake.arrangement.json
